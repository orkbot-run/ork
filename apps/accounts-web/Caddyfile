# Account pages share the dashboard hostname. Only the private API handles auth.
# EasyPanel routes api.orkbot.run directly to Accounts, outside this dashboard proxy.
# When EasyPanel terminates TLS for this proxy, set DASHBOARD_HOST=:80.
{$DASHBOARD_HOST} {
	@accounts path /account /account/*
	header @accounts {
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}

	handle /account/api/auth/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy {$ACCOUNTS_UPSTREAM:https://api.orkbot.run} {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	@pages path /account /account/ /account/sign-in /account/sign-up /account/verify-email /account/forgot-password /account/reset-password
	handle @pages {
		root * {$ACCOUNTS_WEB_ROOT}
		rewrite * /index.html
		file_server
	}

	handle_path /account/assets/* {
		root * {$ACCOUNTS_WEB_ROOT}/assets
		file_server
	}

	handle /account/* {
		respond "Not found" 404
	}

	handle {
		reverse_proxy {$DASHBOARD_UPSTREAM:127.0.0.1:5173}
	}
}
