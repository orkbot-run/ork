{
  "name": "@orkbot/desktop",
  "productName": "Ork",
  "version": "1.3.0",
  "author": {
    "name": "Ork"
  },
  "license": "Apache-2.0 AND PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm tauri:dev",
    "build": "pnpm tauri:build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "tauri:prepare": "node scripts/prepare-tauri.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tsx scripts/build-tauri-passkeys.ts",
    "tauri:test": "pnpm tauri:prepare && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "tauri:check": "pnpm tauri:prepare && tsc --ignoreConfig --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --skipLibCheck --lib es2022,dom tauri-ui/setup.ts tauri-ui/native-bridge.ts && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@orkbot/avatar": "workspace:*",
    "@orkbot/contracts": "workspace:*",
    "@orkbot/core": "workspace:*"
  },
  "devDependencies": {
    "@orkbot/ui-tokens": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
