{
  "name": "@orkbot/desktop",
  "productName": "Ork",
  "version": "0.7.0",
  "author": {
    "name": "Ork"
  },
  "license": "Apache-2.0 AND PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "node scripts/prepare-tauri.mjs",
    "pack": "pnpm run bundle",
    "pack:dir": "tauri build --no-bundle",
    "release": "tauri build",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:native": "pnpm build && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "check:native": "pnpm build && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "tauri:prepare": "pnpm build",
    "tauri:dev": "pnpm dev",
    "tauri:build": "pnpm run bundle",
    "tauri:test": "pnpm test:native",
    "tauri:check": "pnpm check:native",
    "bundle": "tauri build"
  },
  "dependencies": {
    "@orkbot/contracts": "workspace:*"
  },
  "devDependencies": {
    "@orkbot/ui-tokens": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
