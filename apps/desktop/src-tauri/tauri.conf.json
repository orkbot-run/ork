{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ork Preview",
  "version": "../package.json",
  "identifier": "run.orkbot.desktop.preview",
  "build": {
    "beforeDevCommand": "pnpm tauri:prepare",
    "beforeBuildCommand": "pnpm tauri:prepare",
    "frontendDist": "../build/tauri-ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'; frame-src 'none'; frame-ancestors 'none'",
      "capabilities": ["setup"],
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": { "pubkey": "", "requireSignedVersion": true }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/tauri-icons/icon.icns",
      "../build/tauri-icons/icon.ico",
      "../build/tauri-icons/128x128.png"
    ],
    "resources": {
      "../../../LICENSE": "licenses/LICENSE",
      "../../../LICENSE-POLYFORM": "licenses/LICENSE-POLYFORM",
      "../../../LICENSE.md": "licenses/LICENSE.md",
      "../../../NOTICE": "licenses/NOTICE",
      "../../../infra/compose/docker-compose.images.yml": "stack/docker-compose.images.yml",
      "../../../infra/compose/.env.images.example": "stack/.env.images.example",
      "../assets/es.lproj": "es.lproj",
      "../assets/pl.lproj": "pl.lproj",
      "../../../docs/licensing-faq.md": "licenses/docs/licensing-faq.md",
      "../../../docs/commercial-license.md": "licenses/docs/commercial-license.md",
      "../../../docs/licensing-rollout.md": "licenses/docs/licensing-rollout.md",
      "../../../docs/cla/v1.md": "licenses/docs/cla/v1.md"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
