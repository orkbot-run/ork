{
  "expo": {
    "name": "Ork",
    "slug": "orkbot",
    "scheme": "orkbot",
    "version": "1.0.12",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FCFCFC",
          "dark": {
            "backgroundColor": "#141414"
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "Ork uses the microphone for voice calls with your bots."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "Ork turns your speech into messages during voice calls.",
          "microphonePermission": "Ork uses the microphone for voice calls with your bots."
        }
      ],
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ork uses your photo library so you can attach images to a bot message.",
          "cameraPermission": "Ork uses the camera so you can attach photos to a bot message.",
          "microphonePermission": "Ork uses the microphone for voice calls with your bots."
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "audio/*",
              "video/mp4",
              "application/pdf",
              "application/json",
              "application/zip"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "audio/*",
              "video/mp4",
              "application/pdf",
              "application/json",
              "application/zip"
            ]
          }
        }
      ],
      "./plugins/with-worklets-headers",
      "./plugins/with-scene-lifecycle",
      "./plugins/with-lan-cleartext",
      "./plugins/with-agent-notifications",
      "./plugins/with-android-r8",
      "./plugins/with-app-intents"
    ],
    "locales": {
      "es": "./locales/es.json",
      "pl": "./locales/pl.json"
    },
    "ios": {
      "bundleIdentifier": "run.orkbot.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "../../packages/ui-tokens/assets/Ork.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Ork uses the camera so you can attach photos to a bot message.",
        "NSPhotoLibraryUsageDescription": "Ork uses your photo library so you can attach images to a bot message.",
        "NSLocalNetworkUsageDescription": "Ork connects to a self-hosted Ork server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": ["voip", "audio", "remote-notification"],
        "NSUserActivityTypes": ["INSendMessageIntent"]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.developer.usernotifications.communication": true
      }
    },
    "android": {
      "package": "run.orkbot.app",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundImage": "./assets/icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true,
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OrkWidgets",
                  "bundleIdentifier": "run.orkbot.app.widgets"
                },
                {
                  "targetName": "AgentNotifications",
                  "bundleIdentifier": "run.orkbot.app.notifications",
                  "entitlements": {
                    "com.apple.developer.usernotifications.communication": true
                  }
                }
              ]
            }
          }
        }
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    }
  }
}
