import "../styles/home.css";
import { BRAND_COLORS } from "../brand";
import { ANDROID_APP_STORE_URL } from "@orkbot/contracts/client-build";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { ProductDemo } from "./ProductDemo";
import RosterBotAvatar from "./RosterBotAvatar.astro";
import { demoMessages, getDemoBots } from "../i18n/demo";
import { HOME_FEATURE_KINDS, HOME_MODEL_PROVIDERS, getHomeCopy } from "../i18n/home";
import { DEFAULT_LOCALE, LOCALES, LOCALE_HTML_LANG, isLocale, localeHomePath } from "../i18n/locales";
import type { Locale } from "../i18n/locales";
import { availableDesktopPlatforms, desktopDownloadHref, fetchDesktopDownloads, githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeStructuredData } from "../structured-data";
import { APP_URL, GITHUB_URL, IOS_APP_URL, SELF_HOST_GUIDE_PATH, SETUP_PROMPT_URL, SITE_URL } from "../site";

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const copy = getHomeCopy(locale);
const homeHref = localeHomePath(locale);
const themeColor = BRAND_COLORS.find((color) => color.name === "Black")?.hex;
const [starsLabel, desktopDownloads] = await Promise.all([githubStarsLabel(), fetchDesktopDownloads()]);
const desktopPlatforms = availableDesktopPlatforms(desktopDownloads);
const platformNames = { mac: "macOS", windows: "Windows", linux: "Linux" } as const;
const setupAgentPrompt = `Set up Ork for me. Follow the setup prompt at ${SETUP_PROMPT_URL}`;
const pageUrl = new URL(homeHref, SITE_URL).toString();
const structuredData = homeStructuredData({
  pageUrl,
  title: copy.title,
  description: copy.description,
  siteDescription: getHomeCopy(DEFAULT_LOCALE).description,
  inLanguage: LOCALE_HTML_LANG[locale],
  defaultInLanguage: LOCALE_HTML_LANG[DEFAULT_LOCALE],
  availableLanguages: LOCALES.map((language) => getHomeCopy(language).availableLanguage),
  faq: copy.faq.items,
});
---

<BaseLayout {themeColor} title={copy.title} description={copy.description} {structuredData} locale={locale} skipLabel={copy.skipToContent} homeAlternates ogImageAlt={copy.ogImageAlt}>
  <div class="home-page">
    <div class="container home-container">
      <Header locale={locale} copy={copy.nav} starsLabel={starsLabel} homeHref={homeHref} />
      <main id="main">
        <section class="home-hero" aria-labelledby="home-heading">
          <a class="home-kicker" href="#selfhost">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2 3.5 4.5v5c0 4 6.5 8.5 6.5 8.5s6.5-4.5 6.5-8.5v-5L10 2Z" /><path d="m7 10 2 2 4-4" /></svg>
            {copy.positioning.label}
            <span aria-hidden="true">↗</span>
          </a>
          <h1 id="home-heading">{copy.hero.heading}</h1>
          <p class="home-hero__lead">{copy.hero.lead}</p>
          <div class="home-actions">
            <a class="button button--primary" href="/docs/self-host/#local-source-checkout" data-attr="hero-selfhost">{copy.positioning.local}<span aria-hidden="true">↗</span></a>
            <a class="button button--secondary" href={GITHUB_URL} target="_blank" rel="noopener" data-attr="hero-github">{copy.hero.viewOnGithub}<span aria-hidden="true">↗</span></a>
          </div>
        </section>

        <section id="demo" class="home-demo" aria-label={copy.features.heading}>
          <ProductDemo bots={getDemoBots(locale)} strings={demoMessages(locale)} client:load />
        </section>

        <section id="roster" class="home-section home-roster" aria-labelledby="roster-heading">
          <div class="home-section__intro">
            <div class="home-section__index" aria-hidden="true">01 / ORK</div>
            <div>
              <h2 id="roster-heading">{copy.roster.heading}</h2>
              <p>{copy.roster.copy}</p>
            </div>
          </div>
          <div class="home-roster__grid">
            {copy.roster.bots.map((bot) => (
              <article class="home-bot">
                <RosterBotAvatar color={bot.color} name={bot.name} />
                <div><h3>{bot.name}</h3><p>{bot.desc}</p></div>
              </article>
            ))}
          </div>
        </section>

        <section id="features" class="home-section" aria-labelledby="features-heading">
          <div class="home-section__intro">
            <div class="home-section__index" aria-hidden="true">02 / ORK</div>
            <h2 id="features-heading">{copy.features.heading}</h2>
          </div>
          <div class="home-features">
            {HOME_FEATURE_KINDS.map((kind, index) => (
              <article class="home-feature">
                <span class="home-feature__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <h3>{copy.features.items[kind].title}</h3>
                <p>{copy.features.items[kind].body}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="selfhost" class="home-section home-ownership" aria-labelledby="selfhost-heading">
          <div class="home-section__intro">
            <div class="home-section__index" aria-hidden="true">03 / ORK</div>
            <div><h2 id="selfhost-heading">{copy.selfHost.heading}</h2><p>{copy.selfHost.copy}</p></div>
          </div>
          <div class="home-ownership__grid">
            <div class="home-ownership__visual" aria-hidden="true">
              <div class="home-machine">
                <svg viewBox="0 0 160 112"><rect x="20" y="8" width="120" height="80" rx="4" /><path d="M8 102h144l-12-14H20L8 102ZM64 102h32" /><path d="m65 42 10 10-10 10M85 62h15" /></svg>
                <span>localhost</span>
              </div>
              <div class="home-ownership__connection"><span></span><img src="/brand/orkbot-mark.png" alt="" width="64" height="64" loading="lazy" /><span></span></div>
              <div class="home-machine">
                <svg viewBox="0 0 160 112"><rect x="30" y="10" width="100" height="40" rx="4" /><rect x="30" y="62" width="100" height="40" rx="4" /><path d="M46 30h40M46 82h40" /><circle cx="112" cy="30" r="3" /><circle cx="112" cy="82" r="3" /></svg>
                <span>self-hosted</span>
              </div>
            </div>
            <div class="home-ownership__details">
              {copy.selfHost.features.map((feature) => (<div><h3>{feature.title}</h3><p>{feature.body}</p></div>))}
              <div class="home-ownership__links">
                <a href="/docs/self-host/#local-source-checkout">{copy.positioning.local}<span aria-hidden="true">↗</span></a>
                <a href={SELF_HOST_GUIDE_PATH}>{copy.positioning.server}<span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </div>
          <div class="home-models"><span>{copy.selfHost.worksWith}</span><ul>{HOME_MODEL_PROVIDERS.map((name) => (<li>{name}</li>))}</ul></div>
          <p class="home-privacy-note">{copy.positioning.note}</p>
        </section>

        <section id="platforms" class="home-section home-platforms" aria-labelledby="platforms-heading">
          <div class="home-section__intro"><div class="home-section__index" aria-hidden="true">04 / ORK</div><h2 id="platforms-heading">{copy.platforms.heading}</h2></div>
          <div class="home-platforms__grid">
            <article><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="5" width="26" height="22" rx="2" /><path d="M3 11h26M7 8h1m3 0h1" /></svg><h3>{copy.platforms.web}</h3><a href={APP_URL}>{copy.hero.getStarted}<span aria-hidden="true">↗</span></a></article>
            <article><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="6" y="5" width="20" height="17" rx="2" /><path d="M2 27h28l-4-5H6l-4 5Z" /></svg><h3>{copy.platforms.desktop}</h3><div>{desktopPlatforms.length === 0 ? (<a href="/download/">{copy.footer.links.download}<span aria-hidden="true">↗</span></a>) : desktopPlatforms.map((platform) => (<a href={desktopDownloadHref(platform)}>{platformNames[platform]}<span aria-hidden="true">↗</span></a>))}</div></article>
            <article><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="9" y="2" width="14" height="28" rx="3" /><path d="M14 6h4M15 26h2" /></svg><h3>{copy.platforms.mobile}</h3><div><a href={IOS_APP_URL}>iOS<span aria-hidden="true">↗</span></a><a href={ANDROID_APP_STORE_URL}>Android<span aria-hidden="true">↗</span></a></div></article>
          </div>
        </section>

        <section id="faq" class="home-section home-faq-section" aria-labelledby="faq-heading">
          <div class="home-section__intro"><div class="home-section__index" aria-hidden="true">05 / ORK</div><h2 id="faq-heading">{copy.faq.heading}</h2></div>
          <div class="home-questions">{copy.faq.items.map((item) => (<details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>))}</div>
        </section>

        <section class="home-closing" aria-labelledby="closing-heading">
          <img src="/brand/orkbot-mark.png" alt="" width="64" height="64" loading="lazy" />
          <h2 id="closing-heading">{copy.cta.heading}</h2>
          <div class="home-actions"><a class="button button--primary" href="/docs/self-host/#local-source-checkout">{copy.positioning.local}<span aria-hidden="true">↗</span></a><a class="button button--secondary" href={SELF_HOST_GUIDE_PATH}>{copy.positioning.server}<span aria-hidden="true">↗</span></a></div>
          <button class="home-setup" type="button" data-setup-copy={setupAgentPrompt} data-setup-label={copy.hero.setupWithAgent} data-setup-copied={copy.hero.copiedForAgent} data-setup-failed={copy.hero.copyFailed}><span class="home-setup__label" role="status">{copy.hero.setupWithAgent}</span><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="1" /><path d="M13 7V3H3v10h4" /></svg></button>
        </section>
      </main>
      <Footer locale={locale} languagesLabel={copy.footer.languagesLabel} navLabel={copy.footer.navLabel} homeLabel={copy.nav.home} linkLabels={copy.footer.links} homeHref={homeHref} />
    </div>
  </div>
</BaseLayout>

<script>
  import "../support-chat";
  const button = document.querySelector<HTMLButtonElement>("[data-setup-copy]");
  const label = button?.querySelector<HTMLElement>(".home-setup__label");
  button?.addEventListener("click", async () => {
    if (!label || !button.dataset.setupCopy) return;
    try {
      await navigator.clipboard.writeText(button.dataset.setupCopy);
      label.textContent = button.dataset.setupCopied ?? "";
      window.setTimeout(() => { label.textContent = button.dataset.setupLabel ?? ""; }, 2400);
    } catch {
      label.textContent = button.dataset.setupFailed ?? "";
    }
  });
</script>
