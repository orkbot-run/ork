---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {
  availableDesktopPlatforms,
  desktopDownloadHref,
  fetchDesktopDownloads,
  githubStarsLabel,
} from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, SELF_HOST_GUIDE_PATH } from "../site";

const [starsLabel, downloads] = await Promise.all([githubStarsLabel(), fetchDesktopDownloads()]);

const DESKTOP_NAMES = { mac: "macOS", windows: "Windows", linux: "Linux" } as const;
const platforms = [
  ...availableDesktopPlatforms(downloads).map((platform) => ({
    name: DESKTOP_NAMES[platform],
    action: "Download",
    href: desktopDownloadHref(platform),
    attr: platform,
  })),
  { name: "Desktop", action: "Source code", href: `${GITHUB_URL}/tree/main/apps/desktop`, attr: "desktop-source" },
  { name: "iPhone and Android", action: "Source code", href: `${GITHUB_URL}/tree/main/apps/mobile`, attr: "mobile-source" },
  { name: "Web", action: "Run locally", href: SELF_HOST_GUIDE_PATH, attr: "web" },
];
---

<BaseLayout title="Download · Ork" description="Build Ork from source or download available Ork releases.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>Download Ork</h1>
      <ul class="platform-list">
        {
          platforms.map((platform) => (
            <li>
              <span>{platform.name}</span>
              <a
                class="button button--secondary button--small"
                href={platform.href}
                aria-label={`${platform.action}: ${platform.name}`}
                data-attr={`download-page-${platform.attr}`}
              >
                {platform.action}
              </a>
            </li>
          ))
        }
      </ul>
      <p>
        Running your own server? The apps connect to it too. See the{" "}
        <a href={SELF_HOST_GUIDE_PATH}>self-hosting guide</a>.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
