---
// SPDX-License-Identifier: Apache-2.0 AND PolyForm-Noncommercial-1.0.0
// Modified by Ork contributors for prospective licensing. Existing material remains Apache-2.0.
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PlanCard from "../components/PlanCard.astro";
import { githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { COMMERCIAL_DESCRIPTION, LICENSE_DESCRIPTION } from "../licensing";
import { PRICING_PLANS } from "../pricing";

const starsLabel = await githubStarsLabel();
---

<BaseLayout
  title="Pricing · Ork"
  markdownAlternate="/pricing.md"
  description={LICENSE_DESCRIPTION}
>
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="pricing">
      <h1 class="section-heading">Pricing</h1>
      <div class="pricing__plans">
        {
          PRICING_PLANS.slice(0, 1).map((plan, index) => (
            <PlanCard plan={plan} primary={index > 0} attr={`pricing-${index}`} />
          ))
        }
      </div>
      <h2>Commercial self-hosting</h2>
      <p>{COMMERCIAL_DESCRIPTION}</p>
      <p><a href="/license/#commercial">Review commercial terms</a>.</p>
    </main>
    <Footer />
  </div>
</BaseLayout>
