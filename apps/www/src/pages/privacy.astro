---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, SELF_HOST_GUIDE_PATH } from "../site";

const starsLabel = await githubStarsLabel();
---

<BaseLayout title="Privacy · Ork" description="Privacy information for a self-hosted Ork deployment.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>Privacy</h1>
      <p>
        This page describes the self-hosted software. Contact the operator of your Ork server for its
        privacy policy and for account or data requests.
      </p>
      <p>
        The server stores account details, conversations, files, and configured connection credentials.
        Features you enable can send content to the model, voice, memory, and integration providers
        configured for your deployment. Review those settings and the providers' terms before sharing data.
      </p>
      <p>
        The <a href={SELF_HOST_GUIDE_PATH}>self-hosting guide</a> covers deployment configuration.
        The <a href={`${GITHUB_URL}/tree/main/docs`}>project documentation</a> describes storage and account controls.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
