---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, SELF_HOST_GUIDE_PATH } from "../site";

const starsLabel = await githubStarsLabel();
---

<BaseLayout title="Support · Ork" description="Documentation and issue reporting for self-hosted Ork.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>Ork support</h1>
      <p>
        Start with the <a href={SELF_HOST_GUIDE_PATH}>self-hosting guide</a>. For reproducible bugs or feature
        requests, open an issue in the <a href={`${GITHUB_URL}/issues`}>Ork GitHub repository</a>.
        Remove credentials and private content before posting.
      </p>
      <h2 id="account-deletion">Your account and data</h2>
      <p>
        For account, billing, or privacy requests, contact the operator of the Ork server you use.
        Account settings provide deletion controls for that deployment.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
