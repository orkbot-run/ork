---
// SPDX-License-Identifier: Apache-2.0 AND PolyForm-Noncommercial-1.0.0
// Modified by Ork contributors for prospective licensing. Existing material remains Apache-2.0.
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, SELF_HOST_GUIDE_PATH } from "../site";

const starsLabel = await githubStarsLabel();
---

<BaseLayout title="Terms · Ork" description="License and deployment terms for Ork.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>Terms</h1>
      <p>
        The Rakazo and existing Ork baseline remains under the
        <a href={`${GITHUB_URL}/blob/main/LICENSE`}>Apache License, Version 2.0</a>.
        New Ork work uses PolyForm Noncommercial 1.0.0 or a separate paid commercial license.
        Read the <a href="/license/">license scope and commercial terms</a> before using that work.
      </p>
      <p>
        This page does not create a paid subscription or a hosted-service agreement. A server operator
        is responsible for the terms applying to a deployment they offer.
      </p>
      <p>
        Model services, computer providers, and integrations can have their own terms and charges.
        See the <a href={SELF_HOST_GUIDE_PATH}>self-hosting guide</a> for running Ork on your infrastructure.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
