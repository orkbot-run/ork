[Unit]
Description=Notify operators when a production backup fails

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/orkbot-host-alert backup-failure "Nightly backup failed. Inspect orkbot-backup.service on the server."
StateDirectory=orkbot/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/orkbot/alerts
PrivateTmp=true
