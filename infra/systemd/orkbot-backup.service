[Unit]
Description=Create and verify a Ork production backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/orkbot/backup.env
ExecStart=/usr/local/sbin/orkbot-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups
