{
  "name": "orkbot",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "licenses:check": "node scripts/license-headers.mjs",
    "licenses:report": "node scripts/dependency-licenses.mjs",
    "test:licenses": "node --test scripts/license-headers.test.mjs scripts/dependency-licenses.test.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose --project-name ork --env-file .env -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.postgres-host.yml up postgres -d --wait",
    "db:stop": "docker compose --project-name ork --env-file .env -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.postgres-host.yml stop postgres",
    "dev": "node scripts/dev.mjs",
    "gallery": "pnpm --filter @orkbot/web dev --open /e2e/fixtures/gallery.html",
    "build": "turbo build --filter=!@orkbot/desktop",
    "check": "turbo check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @orkbot/db generate",
    "db:migrate": "pnpm --filter @orkbot/api db:migrate",
    "sandbox:build": "docker build -t orkbot/computer:local infra/sandboxes/computer",
    "sandbox:boat-snapshot": "tsx packages/adapters/src/cli/build-boat-snapshot.ts",
    "sandbox:boxd-snapshot": "tsx packages/adapters/src/cli/build-boxd-snapshot.ts",
    "sandbox:novita-template": "tsx packages/adapters/src/cli/build-novita-template.ts",
    "sandbox:e2b-template": "tsx packages/adapters/src/cli/build-e2b-template.ts",
    "test": "node --test scripts/pnpm.test.mjs && vitest run",
    "test:compose-smoke": "bash infra/compose/run-smokes.sh",
    "test:integration": "tsx packages/testkit/src/cli/harness.ts --integration",
    "test:e2e": "tsx packages/testkit/src/cli/harness.ts --e2e",
    "test:mobile-screenshots": "pnpm --filter @orkbot/db generate && tsx packages/testkit/src/cli/mobile-screenshots.ts",
    "ios:screenshots": "pnpm --filter @orkbot/db generate && tsx packages/testkit/src/cli/ios-app-screenshots.ts",
    "test:topology": "tsx packages/testkit/src/cli/topology.ts",
    "test:canary": "tsx packages/testkit/src/cli/canary.ts",
    "test:pi": "vitest run packages/testkit/src/model-emulator.test.ts packages/testkit/src/pi-offline.test.ts",
    "test:evals": "tsx packages/testkit/src/cli/evals.ts",
    "test:computer-replay": "tsx packages/testkit/src/cli/computer-replay.ts",
    "test:computer": "tsx packages/testkit/src/cli/computer.ts",
    "test:flows": "tsx packages/testkit/src/cli/flows.ts",
    "perf:compare": "tsx packages/testkit/src/cli/compare-performance.ts",
    "bench:page-browser": "tsx packages/testkit/src/cli/page-browser-bench.ts",
    "perf:web-chat": "tsx packages/testkit/src/cli/web-chat-performance.ts",
    "compose:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ]
    },
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "proxy-addr@<2.0.8": "2.0.8",
      "dompurify@<3.4.17": "3.4.17",
      "ws@>=8 <8.21.1": "8.22.0",
      "@grpc/grpc-js@<1.14.5": "1.14.7",
      "@opentelemetry/core@>=2 <2.8.0": "2.12.0",
      "@composio/core>undici": "7.30.1",
      "e2b>undici": "7.30.1",
      "e2b>undici8": "npm:undici@8.12.3"
    },
    "patchedDependencies": {
      "dockerode@5.0.1": "patches/dockerode@5.0.1.patch"
    }
  }
}
