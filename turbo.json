{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["COREPACK_ENABLE_DOWNLOAD_PROMPT"],
  "globalDependencies": ["scripts/build-server.mjs", "tsconfig.base.json"],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "env": [
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "ENCRYPTION_KEY",
        "GIT_SHA",
        "ORKBOT_ENABLE_AUTO_UPDATE",
        "PUBLIC_CRISP_WEBSITE_ID",
        "PUBLIC_POSTHOG_HOST",
        "PUBLIC_POSTHOG_KEY",
        "OIDC_CLIENT_ID",
        "ORK_ACCOUNTS_DESKTOP_CLIENT_ID"
      ],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "check": {
      "dependsOn": ["^check", "^generate", "generate"]
    },
    "test": {
      "dependsOn": ["^generate"],
      "env": ["COPY_TEST_DATABASE", "VERIFY_DATABASE"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "env": ["PUBLIC_CRISP_WEBSITE_ID", "PUBLIC_POSTHOG_HOST", "PUBLIC_POSTHOG_KEY"],
      "persistent": true,
      "passThroughEnv": ["ORKBOT_HOST", "ORKBOT_DEV_HOST", "ORKBOT_ALLOWED_HOSTS"]
    }
  }
}
